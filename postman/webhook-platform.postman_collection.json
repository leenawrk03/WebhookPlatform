{
  "info": {
    "name": "Webhook Platform - Phase 1",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "token", "value": "" }
  ],
  "item": [
    {
      "name": "Login",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.collectionVariables.set('token', pm.response.json().token);"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/api/auth/login",
        "body": { "mode": "raw", "raw": "{\n  \"username\": \"admin\",\n  \"password\": \"admin123\"\n}" }
      }
    },
    {
      "name": "Create destination",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "Authorization", "value": "Bearer {{token}}" }
        ],
        "url": "{{baseUrl}}/api/destinations",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"name\": \"Stripe Payments\",\n  \"source\": \"stripe\",\n  \"targetUrl\": \"https://myapp.com/webhooks\",\n  \"secret\": \"s3cr3t\",\n  \"active\": true\n}"
        }
      }
    },
    {
      "name": "List destinations",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{baseUrl}}/api/destinations"
      }
    },
    {
      "name": "Send Stripe webhook",
      "request": {
        "method": "POST",
        "header": [{ "key": "Content-Type", "value": "application/json" }],
        "url": "{{baseUrl}}/api/webhooks/stripe",
        "body": {
          "mode": "raw",
          "raw": "{\n  \"id\": \"evt_123\",\n  \"type\": \"payment_intent.succeeded\",\n  \"data\": { \"amount\": 4200 }\n}"
        }
      }
    },
    {
      "name": "Send GitHub webhook",
      "request": {
        "method": "POST",
        "header": [
          { "key": "Content-Type", "value": "application/json" },
          { "key": "X-GitHub-Event", "value": "pull_request" },
          { "key": "X-GitHub-Delivery", "value": "d-001" }
        ],
        "url": "{{baseUrl}}/api/webhooks/github",
        "body": { "mode": "raw", "raw": "{\n  \"action\": \"opened\",\n  \"number\": 42\n}" }
      }
    },
    {
      "name": "List events",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{baseUrl}}/api/events?page=0&size=20"
      }
    },
    {
      "name": "Stats",
      "request": {
        "method": "GET",
        "header": [{ "key": "Authorization", "value": "Bearer {{token}}" }],
        "url": "{{baseUrl}}/api/stats"
      }
    }
  ]
}
