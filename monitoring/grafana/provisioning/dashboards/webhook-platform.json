{
  "title": "Webhook Platform",
  "uid": "webhook-platform",
  "schemaVersion": 39,
  "refresh": "10s",
  "time": { "from": "now-1h", "to": "now" },
  "panels": [
    {
      "type": "stat",
      "title": "Events received (rate/min)",
      "gridPos": { "h": 6, "w": 6, "x": 0, "y": 0 },
      "targets": [{ "expr": "sum(rate(webhook_events_received_total[5m])) * 60", "refId": "A" }]
    },
    {
      "type": "stat",
      "title": "Delivery success rate",
      "gridPos": { "h": 6, "w": 6, "x": 6, "y": 0 },
      "targets": [{
        "expr": "sum(rate(webhook_deliveries_success_total[5m])) / clamp_min(sum(rate(webhook_deliveries_success_total[5m])) + sum(rate(webhook_deliveries_failed_total[5m])), 0.0001)",
        "refId": "A"
      }]
    },
    {
      "type": "timeseries",
      "title": "Failures and retries",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
      "targets": [
        { "expr": "sum(rate(webhook_deliveries_failed_total[5m]))", "legendFormat": "failures", "refId": "A" },
        { "expr": "sum(rate(webhook_delivery_retries_total[5m]))", "legendFormat": "retries", "refId": "B" }
      ]
    },
    {
      "type": "timeseries",
      "title": "Delivery latency p95 (s)",
      "gridPos": { "h": 8, "w": 12, "x": 0, "y": 8 },
      "targets": [{
        "expr": "histogram_quantile(0.95, sum(rate(webhook_delivery_duration_seconds_bucket[5m])) by (le))",
        "refId": "A"
      }]
    },
    {
      "type": "timeseries",
      "title": "API endpoint latency p95 (s)",
      "gridPos": { "h": 8, "w": 12, "x": 12, "y": 8 },
      "targets": [{
        "expr": "histogram_quantile(0.95, sum(rate(http_server_requests_seconds_bucket[5m])) by (le, uri))",
        "legendFormat": "{{uri}}",
        "refId": "A"
      }]
    }
  ]
}
